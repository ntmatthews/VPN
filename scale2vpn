#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONFIG_DIR="/etc/scale2vpn"
readonly INSTALL_BIN="/usr/local/bin/scale2vpn"
readonly CONSOLE_SCRIPT="/usr/local/lib/scale2vpn/console.py"
readonly SYNC_SERVICE="/etc/systemd/system/scale2vpn-auto-sync.service"
readonly SYNC_TIMER="/etc/systemd/system/scale2vpn-auto-sync.timer"

usage() {
    cat <<'EOF'
Usage:
  scale2vpn auto sync [off|status]       Enable (default), disable, or inspect daily updates
  scale2vpn sync [--source DIRECTORY]    Update Scale2VPN program files
  scale2vpn on                           Start the IKEv2 VPN
  scale2vpn off                          Stop the IKEv2 VPN
  scale2vpn status                       Show service and device status
  scale2vpn create [DISPLAY NAME]        Create a certificate-authenticated device
  scale2vpn delete [DEVICE] [--yes]      Revoke a device (asks for confirmation)
  scale2vpn reset [console]              Restart VPN, or reset the console password
  scale2vpn tls setup DOMAIN EMAIL       Enable trusted Let's Encrypt HTTPS
  scale2vpn uninstall [--yes]            Remove Scale2VPN; keeps UFW and system packages
  scale2vpn device status                List devices and connection state
  scale2vpn update                       Alias for "sync"
  scale2vpn reset-console-password       Alias for "reset console"
EOF
}

fail() {
    printf 'Scale2VPN: %s\n' "$*" >&2
    exit 1
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
    usage
    exit 0
fi

[[ "${EUID}" -eq 0 ]] || fail "run this command as root (for example: sudo scale2vpn status)"

require_install() {
    [[ -d "${CONFIG_DIR}" ]] || fail "Scale2VPN is not installed"
}

enable_auto_sync() {
    cat > "${SYNC_SERVICE}" <<'EOF'
[Unit]
Description=Update Scale2VPN program files

[Service]
Type=oneshot
ExecStart=/usr/local/bin/scale2vpn sync --scheduled
EOF
    cat > "${SYNC_TIMER}" <<'EOF'
[Unit]
Description=Daily Scale2VPN update check

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF
    systemctl daemon-reload
    systemctl enable --now scale2vpn-auto-sync.timer
    printf 'Automatic daily Scale2VPN sync is enabled.\n'
}

disable_auto_sync() {
    if systemctl is-active --quiet scale2vpn-auto-sync.timer 2>/dev/null; then
        systemctl disable --now scale2vpn-auto-sync.timer
    else
        systemctl disable scale2vpn-auto-sync.timer >/dev/null 2>&1 || true
    fi
    rm -f "${SYNC_SERVICE}" "${SYNC_TIMER}"
    systemctl daemon-reload
    printf 'Automatic Scale2VPN sync is disabled.\n'
}

sync_program() {
    local source_dir="$1"
    local temporary=""
    require_install
    command -v systemctl >/dev/null 2>&1 || fail "systemctl is required to apply updates"

    if [[ -z "${source_dir}" ]]; then
        command -v git >/dev/null 2>&1 || fail "git is required to sync from GitHub"
        temporary="$(mktemp -d /tmp/scale2vpn-sync.XXXXXX)"
        trap 'rm -rf -- "${temporary}"' EXIT
        source_dir="${temporary}/source"
        printf 'Downloading Scale2VPN program files...\n'
        git clone --quiet --depth 1 --branch main \
            https://github.com/ntmatthews/VPN.git "${source_dir}"
    else
        [[ -d "${source_dir}" ]] || fail "source directory does not exist: ${source_dir}"
        source_dir="$(cd -- "${source_dir}" && pwd)"
    fi

    for file in scale2vpn scale2vpn-console.py scale2vpn-console.service; do
        [[ -f "${source_dir}/${file}" ]] || fail "sync source is missing required file ${file}"
    done
    python3 -c 'import pathlib, sys; compile(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"), sys.argv[1], "exec")' \
        "${source_dir}/scale2vpn-console.py"
    install -o root -g root -m 755 "${source_dir}/scale2vpn" "${INSTALL_BIN}"
    install -o root -g root -m 755 "${source_dir}/scale2vpn-console.py" "${CONSOLE_SCRIPT}"
    install -o root -g root -m 644 "${source_dir}/scale2vpn-console.service" \
        /etc/systemd/system/scale2vpn-console.service
    systemctl daemon-reload
    systemctl restart scale2vpn-console.service
    printf 'Scale2VPN program files synced. VPN settings, certificates, and devices are unchanged.\n'
}

reset_console_password() {
    require_install
    local password temporary
    password="$(openssl rand -hex 24)"
    temporary="$(mktemp "${CONFIG_DIR}/.console-password.XXXXXX")"
    printf '%s' "${password}" | sha256sum | awk '{print $1}' > "${temporary}"
    chmod 600 "${temporary}"
    mv -f "${temporary}" "${CONFIG_DIR}/console-password.sha256"
    printf 'Console username: admin\nNew console password: %s\n' "${password}"
}

uninstall_scale2vpn() {
    local confirm="${1:-}"
    local ipv4_pool="" ipv6_pool="" public_interface="" public_interface_v6=""
    if [[ "${confirm}" != "--yes" ]]; then
        printf 'This removes Scale2VPN devices, certificates, VPN settings, and downloaded device bundles.\n'
        read -r -p "Type UNINSTALL to continue: " confirm || fail "uninstall cancelled"
        [[ "${confirm}" == "UNINSTALL" ]] || fail "uninstall cancelled"
    fi
    require_install

    if [[ -r "${CONFIG_DIR}/ipv4-pool" ]]; then ipv4_pool="$(<"${CONFIG_DIR}/ipv4-pool")"; fi
    if [[ -r "${CONFIG_DIR}/ipv6-pool" ]]; then ipv6_pool="$(<"${CONFIG_DIR}/ipv6-pool")"; fi
    if [[ -r "${CONFIG_DIR}/public-interface" ]]; then public_interface="$(<"${CONFIG_DIR}/public-interface")"; fi
    if [[ -r "${CONFIG_DIR}/public-interface-v6" ]]; then public_interface_v6="$(<"${CONFIG_DIR}/public-interface-v6")"; fi

    for unit in scale2vpn-auto-sync.timer scale2vpn-auto-sync.service scale2vpn-console.service; do
        if systemctl is-active --quiet "${unit}" 2>/dev/null; then
            systemctl stop "${unit}"
        fi
        systemctl disable "${unit}" >/dev/null 2>&1 || true
    done
    if systemctl is-active --quiet strongswan-starter.service; then
        while IFS= read -r connection; do
            [[ -n "${connection}" ]] || continue
            ipsec down "${connection}" >/dev/null 2>&1 || true
        done < <(python3 - "${CONFIG_DIR}/devices.json" <<'PY'
import json
import re
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    devices = json.load(source)
for device_id in devices:
    if re.fullmatch(r"[0-9a-f]{24}", device_id):
        print(f"scale2vpn-device-{device_id}")
PY
        )
    fi

    if command -v ufw >/dev/null 2>&1; then
        if [[ -n "${ipv4_pool}" && -n "${public_interface}" ]]; then
            ufw --force delete route allow in on "${public_interface}" out on "${public_interface}" \
                from "${ipv4_pool}" to any >/dev/null 2>&1 || true
        fi
        if [[ -n "${ipv6_pool}" && -n "${public_interface_v6}" ]]; then
            ufw --force delete route allow in on "${public_interface_v6}" out on "${public_interface_v6}" \
                from "${ipv6_pool}" to any >/dev/null 2>&1 || true
        fi
        ufw --force delete allow 500/udp >/dev/null 2>&1 || true
        ufw --force delete allow 4500/udp >/dev/null 2>&1 || true
        ufw --force delete limit 8443/tcp >/dev/null 2>&1 || true
        ufw --force delete allow 80/tcp comment "Scale2VPN ACME validation" >/dev/null 2>&1 || true
    fi

    python3 - <<'PY'
from pathlib import Path

begin = "# BEGIN SCALE2VPN NAT"
end = "# END SCALE2VPN NAT"
for path in (Path("/etc/ufw/before.rules"), Path("/etc/ufw/before6.rules")):
    if not path.exists():
        continue
    text = path.read_text(encoding="utf-8")
    start = text.find(begin)
    if start < 0:
        continue
    finish = text.find(end, start)
    if finish < 0:
        raise SystemExit(f"Unterminated Scale2VPN NAT block in {path}; refusing to modify it")
    finish += len(end)
    path.write_text(text[:start] + text[finish:].lstrip("\n"), encoding="utf-8")
PY
    if command -v ufw >/dev/null 2>&1 && ufw status | grep -q '^Status: active'; then
        ufw reload
    fi

    rm -f /etc/sysctl.d/90-scale2vpn.conf
    rm -f /etc/ipsec.d/scale2vpn.conf /etc/ipsec.d/scale2vpn.secrets \
        /etc/ipsec.d/scale2vpn_devices.conf \
        /etc/ipsec.d/certs/scale2vpn-server-cert.pem \
        /etc/ipsec.d/certs/scale2vpn-console-chain.pem \
        /etc/ipsec.d/private/scale2vpn-server-key.pem \
        /etc/ipsec.d/cacerts/scale2vpn-root.pem \
        /etc/ipsec.d/cacerts/scale2vpn-intermediate.pem
    if systemctl is-active --quiet strongswan-starter.service; then
        ipsec reload
    fi
    rm -rf -- "${CONFIG_DIR}" /root/scale2vpn-devices
    rm -f /etc/systemd/system/scale2vpn-console.service \
        /etc/systemd/system/scale2vpn-auto-sync.service \
        /etc/systemd/system/scale2vpn-auto-sync.timer
    rm -f /etc/letsencrypt/renewal-hooks/deploy/scale2vpn-reload-console
    rm -f "${INSTALL_BIN}" "${CONSOLE_SCRIPT}"
    rmdir /usr/local/lib/scale2vpn 2>/dev/null || true
    systemctl daemon-reload
    sysctl --system >/dev/null
    printf 'Scale2VPN has been removed. UFW, SSH rules, system packages, and the shared strongSwan service were preserved.\n'
}

case "${1:-}" in
    auto)
        require_install
        [[ "${2:-}" == "sync" ]] || { usage >&2; exit 2; }
        case "${3:-on}" in
            on) [[ $# -le 3 ]] || { usage >&2; exit 2; }; enable_auto_sync ;;
            off) [[ $# -eq 3 ]] || { usage >&2; exit 2; }; disable_auto_sync ;;
            status) [[ $# -eq 3 ]] || { usage >&2; exit 2; }; systemctl status scale2vpn-auto-sync.timer --no-pager ;;
            *) usage >&2; exit 2 ;;
        esac
        ;;
    sync|update)
        source_dir=""
        if [[ "${2:-}" == "--scheduled" ]]; then
            [[ $# -eq 2 ]] || { usage >&2; exit 2; }
        elif [[ "${2:-}" == "--source" && $# -eq 3 ]]; then
            source_dir="$3"
        elif [[ $# -ne 1 ]]; then
            usage >&2
            exit 2
        fi
        sync_program "${source_dir}"
        ;;
    on)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        require_install
        systemctl start strongswan-starter.service
        printf 'Scale2VPN VPN is on.\n'
        ;;
    off)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        require_install
        systemctl stop strongswan-starter.service
        printf 'Scale2VPN VPN is off. The administration console remains available.\n'
        ;;
    status)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        require_install
        printf 'VPN service: %s\n' "$(systemctl is-active strongswan-starter.service || true)"
        printf 'Console service: %s\n' "$(systemctl is-active scale2vpn-console.service || true)"
        if systemctl is-active --quiet strongswan-starter.service; then
            ipsec statusall
        fi
        python3 "${CONSOLE_SCRIPT}" device-status
        ;;
    device)
        [[ $# -eq 2 && "${2}" == "status" ]] || { usage >&2; exit 2; }
        require_install
        python3 "${CONSOLE_SCRIPT}" device-status
        ;;
    tls)
        [[ $# -eq 4 && "${2}" == "setup" ]] || { usage >&2; exit 2; }
        require_install
        python3 "${CONSOLE_SCRIPT}" tls-setup "${3}" "${4}"
        ;;
    create)
        require_install
        if [[ $# -gt 2 ]]; then usage >&2; exit 2; fi
        if [[ $# -eq 1 ]]; then
            read -r -p "Device display name: " display_name || fail "device creation cancelled"
        else
            display_name="$2"
        fi
        [[ -n "${display_name//[[:space:]]/}" ]] || fail "display name cannot be empty"
        python3 "${CONSOLE_SCRIPT}" device-create "${display_name}"
        ;;
    delete)
        require_install
        if [[ $# -eq 1 ]]; then
            python3 "${CONSOLE_SCRIPT}" device-status
            read -r -p "Device ID, Local ID, or exact display name to revoke: " identifier \
                || fail "device deletion cancelled"
            python3 "${CONSOLE_SCRIPT}" device-delete "${identifier}"
        elif [[ $# -eq 2 && "${2}" != "--yes" ]]; then
            python3 "${CONSOLE_SCRIPT}" device-delete "$2"
        elif [[ $# -eq 3 && "${3}" == "--yes" ]]; then
            python3 "${CONSOLE_SCRIPT}" device-delete "$2" --yes
        else
            usage >&2
            exit 2
        fi
        ;;
    reset)
        require_install
        if [[ $# -eq 1 ]]; then
            systemctl restart strongswan-starter.service
            printf 'Scale2VPN VPN service restarted.\n'
        elif [[ $# -eq 2 && "${2}" == "console" ]]; then
            reset_console_password
        else
            usage >&2
            exit 2
        fi
        ;;
    reset-console-password)
        [[ $# -eq 1 ]] || { usage >&2; exit 2; }
        reset_console_password
        ;;
    uninstall)
        [[ $# -le 2 && ( $# -eq 1 || "${2}" == "--yes" ) ]] || { usage >&2; exit 2; }
        uninstall_scale2vpn "${2:-}"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
